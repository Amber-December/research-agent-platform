UPSTREAM_BASE_URL=https://token4research.cn/v1
UPSTREAM_API_KEY=sk-your-key
UPSTREAM_MODEL=gpt-5.4-mini
PUBLIC_API_KEY=sk-your-public-integration-key
IMAGE_MODEL=gpt-image-2
REQUEST_TIMEOUT_SECONDS=120
IMAGE_REQUEST_TIMEOUT_SECONDS=300
PRESENTATION_TEMPLATE=auto
PRESENTATION_MAX_SLIDES=12
PRESENTATION_SOURCE_LIMIT=40
WRITE_SOURCE_LIMIT=50
# Optional override. By default ARIS skills/templates are loaded from this repository.
# ARIS_REPO_ROOT=
UPLOAD_MAX_FILES=20
UPLOAD_MAX_FILE_MB=100
SCHOLAR_REQUEST_TIMEOUT_SECONDS=30
SCHOLAR_RESULTS_PER_SOURCE=4
REVIEW_MINIMUM_SOURCES=10
REVIEW_RECOMMENDED_SOURCES=15
REVIEW_DOWNLOAD_ENABLED=true
REVIEW_DOWNLOAD_LIMIT=30
REVIEW_DOWNLOAD_MAX_MB=50
REVIEW_DOWNLOAD_TIMEOUT_SECONDS=60
INSTITUTION_ACCESS_ENABLED=true
INSTITUTION_NAME=Tsinghua University
INSTITUTION_GATEWAY_BASE=https://tlink.lib.tsinghua.edu.cn/
INSTITUTION_EPROXY_BASE=https://eproxy.lib.tsinghua.edu.cn/reader/home
INSTITUTION_OPENURL_BASE=
INSTITUTION_PROXY_PREFIX=
INSTITUTION_DOWNLOAD_MODE=handoff
WOS_API_BASE_URL=https://api.clarivate.com/apis/wos-starter/v1
WOS_API_KEY=
WOS_DEFAULT_DB=WOS
CNKI_SEARCH_ENDPOINT=
CNKI_SEARCH_METHOD=GET
CNKI_API_KEY=
CNKI_AUTH_HEADER=X-ApiKey
CNKI_AUTH_SCHEME=

# Optional Seafile workspace sync. Prefer an API token. Keep real credentials in .env only.
CLOUD_SYNC_ENABLED=false
CLOUD_DELIVERY_REQUIRED=false
SEAFILE_BASE_URL=https://cloud.tsinghua.edu.cn
SEAFILE_API_TOKEN=
SEAFILE_USERNAME=
SEAFILE_PASSWORD=
SEAFILE_REPO_ID=
SEAFILE_REPO_NAME=Research Agent
SEAFILE_REMOTE_ROOT=research-agent
SEAFILE_SHARE_LINKS=true
SEAFILE_SHARE_PASSWORD=
SEAFILE_SYNC_RETRIES=3
